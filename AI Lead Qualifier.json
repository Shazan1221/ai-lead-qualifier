    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\n\nconst lead = {\n  name: row['Full Name'] || 'Unknown',\n  email: row['Email Address'] || '',\n  service: row['What service are you looking for?'] || '',\n  budget: row['What is your budget? (in USD)'] || '0'\n};\n\nreturn [{ json: { lead } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "1eba32c5-431b-49e0-b0b2-23dc40fe58f0",
      "name": "Extract Lead Info"
    },
    {
      "parameters": {
        "jsCode": "const lead = $input.first().json.lead;\n\nconst body = {\n  model: \"claude-haiku-4-5-20251001\",\n  max_tokens: 1024,\n  messages: [\n    {\n      role: \"user\",\n      content: `You are a lead qualification assistant. Score this lead from 1-10 and write a short personalized reply email.\n\nLead details:\n- Name: ${lead.name}\n- Service needed: ${lead.service}\n- Budget: ${lead.budget}\n\nRespond in this exact format:\nSCORE: [number]/10\nREASON: [one sentence why]\nEMAIL_SUBJECT: [subject line]\nEMAIL_BODY: [2-3 sentence personalized reply email addressing them by name]`\n    }\n  ]\n};\n\nreturn [{ json: { body, lead } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "7c3d9b54-f552-4380-87fb-4c4501fa2b4d",
      "name": "Build Scoring Prompt"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {

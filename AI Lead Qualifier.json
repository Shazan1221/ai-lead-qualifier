      ],
      "id": "a7efd8ec-a936-4be5-8701-20e3626beb65",
      "name": "Score with Claude"
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content[0].text;\n\n// Parse Claude's structured response\nconst scoreMatch = text.match(/SCORE:\\s*(\\d+)\\/10/);\nconst reasonMatch = text.match(/REASON:\\s*(.+)/);\nconst subjectMatch = text.match(/EMAIL_SUBJECT:\\s*(.+)/);\nconst bodyMatch = text.match(/EMAIL_BODY:\\s*([\\s\\S]+)/);\n\nconst score = scoreMatch ? parseInt(scoreMatch[1]) : 0;\nconst reason = reasonMatch ? reasonMatch[1].trim() : '';\nconst emailSubject = subjectMatch ? subjectMatch[1].trim() : 'Thank you for your inquiry';\nconst emailBody = bodyMatch ? bodyMatch[1].trim() : '';\n\n// Pull lead info from the Build Scoring Prompt node\nconst lead = $('Build Scoring Prompt').item.json.lead;\n\nreturn [{\n  json: {\n    score,\n    reason,\n    emailSubject,\n    emailBody,\n    leadEmail: lead.email,\n    leadName: lead.name\n  }\n}];"
      },
